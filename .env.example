# Public browser configuration (copy values into supabase-config.js for the
# static PWA; do NOT rename this file to a tracked real .env file).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_REDIRECT_TO=https://YOUR_GITHUB_USERNAME.github.io/YOUR_REPOSITORY/

# Edge Function runtime secret. Supabase provides these automatically when the
# function is deployed; never add a real service-role key to GitHub Pages.
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_IN_SUPABASE_EDGE_FUNCTION_SECRETS

